package openidea:plugin@1.2.0;

/// Writes to the IDE log, tagged with the plugin id.
interface log {
    use types.{log-level};

    log: func(level: log-level, message: string);
}

interface ui {
    use types.{error, notification-level};

    record status-item {
        text: string,
        tooltip: option<string>,
        /// One of the plugin's commands, run when the item is clicked.
        command: option<string>,
    }

    /// Shows a notification balloon in the window the current command or
    /// event came from (every window when there is none).
    show-notification: func(level: notification-level, title: string, body: string);
    /// Shows or updates the plugin's status bar item `id` in every window.
    set-status-item: func(id: string, item: status-item);
    remove-status-item: func(id: string);
    /// Sets (`some`) or removes (`none`) the plugin's context key `key` in the
    /// window the current command or event came from (every window when there is
    /// none), for `when` clauses as `plugin.<id>.<key>`. A window's value takes
    /// precedence over the global one; global calls don't clear window keys.
    /// `value` is JSON text of a boolean, number or string (the string at most 1024
    /// bytes, the raw text at most 4096 bytes); `key` is 1-64 of `A-Za-z0-9_-`; at
    /// most 100 keys.
    set-context: func(key: string, value: option<string>) -> result<_, error>;
    /// Copies `text` to the system clipboard. Requires `clipboard`.
    copy-to-clipboard: func(text: string) -> result<_, error>;
    /// Opens an `http://` or `https://` URL in the user's default browser.
    open-url: func(url: string) -> result<_, error>;
}

/// Persistent key-value storage of the plugin (survives restarts and idle
/// reclaim; instance memory does not). Requires `storage`. At most 1 MiB.
interface storage {
    use types.{error};

    get: func(key: string) -> result<option<string>, error>;
    set: func(key: string, value: string) -> result<_, error>;
    delete: func(key: string) -> result<_, error>;
    /// Keys starting with `prefix`, sorted.
    keys: func(prefix: string) -> result<list<string>, error>;
}
