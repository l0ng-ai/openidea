package openidea:plugin@1.3.0;

/// Files outside the windows' projects: the configuration of the program a
/// plugin integrates with, a tool installed elsewhere, a licence file.
///
/// A plugin's own WASI has no preopened directory, so every path here is
/// checked against the `fs.read:<path>` / `fs.write:<path>` grants of its
/// manifest; a file inside a project is `workspace.project.read-file`. `path`
/// is absolute, or starts with `~/` for the user's home.
interface fs {
    use types.{error};

    /// The text of a file, decoded as the editor decodes it (BOM and encoding
    /// detection), at most 16 MiB. Unsaved editor contents win, as they do for
    /// project files.
    ///
    /// Without a grant covering the file this returns `denied` naming the
    /// `fs.read:<path>` the manifest has to declare.
    read-text: func(path: string) -> result<string, error>;

    /// The bytes of a file (images, class files, archives), at most 16 MiB.
    read-bytes: func(path: string) -> result<list<u8>, error>;

    /// Whether `path` is a file or a directory; `not-found` when it is neither.
    stat: func(path: string) -> result<file-kind, error>;

    /// What is directly under a directory, sorted by name and capped at 4096
    /// entries like `find-files`; reading a file as a directory is `invalid`.
    ///
    /// Without a grant covering the directory this returns `denied` naming the
    /// `fs.read:<path>` the manifest has to declare.
    read-dir: func(path: string) -> result<list<dir-entry>, error>;
    /// Replaces the text of a file, creating it when it is not there, at most
    /// 16 MiB. The write is atomic (a temporary file is renamed over it) and
    /// keeps the file's encoding and BOM; a new file is UTF-8. Fails with
    /// `invalid` when the text cannot be written in that encoding, when the
    /// parent directory is missing, when the path is a directory, or when the
    /// editor holds unsaved changes for it — save those first.
    ///
    /// Needs an `fs.write:<path>` grant covering the file; write does not imply
    /// read.
    write-text: func(path: string, text: string) -> result<_, error>;

    /// Replaces the bytes of a file, creating it when it is not there, at most
    /// 16 MiB, atomically; the same failures as `write-text`, minus encoding.
    write-bytes: func(path: string, bytes: list<u8>) -> result<_, error>;

    enum file-kind {
        file,
        directory,
    }

    record dir-entry {
        name: string,
        kind: file-kind,
    }
}
