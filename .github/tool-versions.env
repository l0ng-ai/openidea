# Language server and tool versions for Language smoke (.github/workflows/language-smoke.yml)
# and the code-intelligence evals (pnpm eval). Pinned so a release can't fail an unrelated
# PR or move a golden result; bump them deliberately (and re-record goldens: pnpm eval --update-golden).
VTSLS=0.3.0
TYPESCRIPT=6.0.3
BASEDPYRIGHT=1.40.2
RUFF=0.17.3
GOPLS=v0.24.0
JDTLS=1.63.0-202610191322
# sha256 of the jdt-language-server-$JDTLS.tar.gz tarball (language-smoke.yml verifies downloads).
JDTLS_SHA256=b1f2abe0b3cccb462cf64fb4a5587c7d09df60cf8be7748b152cbd89d018bdc4
KOTLIN_LSP=271.2085.0
# sha256 of kotlin-server-$KOTLIN_LSP.tar.gz and .win.zip; scripts/ci/bump-kotlin-lsp.mjs rewrites all three lines.
KOTLIN_LSP_SHA256_LINUX=e398e799027f41749ea33faa57470307d13d40f910961858c7e30adbd778ae08
KOTLIN_LSP_SHA256_WINDOWS=da210a7d84a06f855b8b7b04c5bd54936d270e79f3ea13a9c6ddc2f1046b2a98
GRADLE=8.14.3
INTELEPHENSE=1.18.5
