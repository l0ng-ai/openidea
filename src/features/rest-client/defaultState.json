      "id": "col-users",
      "name": "User Management API",
      "expanded": true,
      "requests": [
        {
          "id": "req-get-users",
          "name": "GET /users",
          "method": "GET",
          "url": "{{baseUrl}}/users?_limit=5",
          "params": [
            {
              "enabled": true,
              "key": "_limit",
              "value": "5",
              "description": "Limit number of returned users"
            }
          ],
          "auth": {
            "type": "none",
            "bearer": "",
            "username": "",
            "password": "",
            "apiKeyKey": "X-API-Key",
            "apiKeyVal": "{{apiKey}}",
            "apiKeyIn": "header"
          },
          "headers": [
            {
              "enabled": true,
              "key": "Accept",
              "value": "application/json",
              "description": "Expected response format"
            },
            {
              "enabled": true,
              "key": "X-Client-Platform",
              "value": "Postman-Desktop-Clone",
              "description": "Custom tracking header"
            }
          ],
          "body": {
            "mode": "none",
            "rawLang": "json",
            "raw": "",
            "formData": [],
            "urlencoded": [],
            "graphqlQuery": "",
            "graphqlVars": "{}"
          },
          "scripts": {
            "preRequest": "// Runs before sending the HTTP request\nconsole.log(\"Preparing GET /users request...\");",
            "postResponse": "pm.test(\"Status code is 200 OK\", () => {\n  pm.expect(pm.response.code).toBe(200);\n});\n\npm.test(\"Response is a non-empty array of users\", () => {\n  const data = pm.response.json();\n  pm.expect(Array.isArray(data)).toBe(true);\n  pm.expect(data.length).toBeGreaterThan(0);\n});"
          },
          "settings": {
            "timeout": 15000,
            "followRedirects": true,
            "disableCache": false
          }
        },
        {
          "id": "req-get-user-by-id",
