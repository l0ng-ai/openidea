-                    let targetFrac = findFraction(structure, target);
-                    let spaceFrac = ((pxRight - pxLeft) / 2 + marginWidth) / totalWidth;
-                    left = targetFrac - spaceFrac;
-                    right = targetFrac + spaceFrac;
+                if (targetX != null) {
+                    let space = (pxRight - pxLeft) / 2 + marginWidth;
+                    left = (targetX - space) / totalWidth;
+                    right = (targetX + space) / totalWidth;
                 }
                 else {
                     left = (pxLeft - marginWidth) / totalWidth;
@@ -9675,7 +9682,9 @@ const hideNativeSelection = state.Prec.highest(EditorView.theme({
         "& :focus": {
             caretColor: "initial !important",
             ...drawMainRange ? {
-                "&::selection, & ::selection": {
+                // Not `& ::selection` too: a pseudo-class with a universal descendant restyles the
+                // whole subtree of every element that gains or loses focus.
+                "&::selection": {
                     backgroundColor: "Highlight !important"
                 }
             } : {}
