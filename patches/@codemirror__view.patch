+            let line = this.state.doc.lineAt(head), structure = lineStructure(line.from, line.to, this.stateDeco);
+            targetX = (structure.total ? findFraction(structure, head) * structure.total : 0) * this.heightOracle.charWidth;
+        }
         let checkLine = (line) => {
             if (line.length < doubleMargin || line.type != exports.BlockType.Text)
                 return;
@@ -6604,11 +6612,10 @@ class ViewState {
