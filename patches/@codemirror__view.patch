@@ -6568,6 +6568,14 @@ class ViewState {
             }
             gaps.push(gap);
         };
+        let head = this.scrollTarget ? this.scrollTarget.range.head : -1, targetX = null;
+        if (head >= 0 && !wrapping) {
+            // Unwrapped lines all centre on the target's x, taken from the target's own line (long or not). The
+            // target's fraction of another line is 1 above it and negative below it, so every long line above
