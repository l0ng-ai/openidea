<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- wasmtime (plugin host) compiles WebAssembly to native code at runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Let main honour DYLD_FRAMEWORK_PATH when it re-execs into the WebKit
       staged by a Safari update on macOS 11 / pre-15.4 12. The staged
       framework is Apple-signed, so library validation stays enabled. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
