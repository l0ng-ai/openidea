<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <extension point="org.eclipse.jdt.ls.core.delegateCommandHandler">
    <delegateCommandHandler class="ai.openidea.usages.CoveredFilesCommand">
      <command id="openidea.workspace.coveredFiles"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.openidea.usages.CoveredRootsCommand">
      <command id="openidea.workspace.coveredRoots"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.openidea.usages.UsagesCommand">
      <command id="openidea.java.usages"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.openidea.configuration.ConfigurationCommand">
      <command id="openidea.java.configuration"/>
      <command id="openidea.java.configuration.warmup"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.openidea.implementations.ImplementationsCommand">
      <command id="openidea.java.implementations"/>
    </delegateCommandHandler>
    <delegateCommandHandler class="ai.openidea.hierarchy.HierarchyCommand">
      <command id="openidea.java.hierarchy.members"/>
      <command id="openidea.java.hierarchy.refactor"/>
    </delegateCommandHandler>
  </extension>
</plugin>
