{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenIDEA Mobile",
  "identifier": "ai.l0ng.openidea.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev:phone",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build:phone",
    "frontendDist": "../dist-phone"
  },
  "app": {
    "windows": [{ "label": "main", "title": "OpenIDEA" }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
