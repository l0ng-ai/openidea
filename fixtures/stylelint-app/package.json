{
  "name": "openidea-fixture-stylelint",
  "version": "0.1.0",
  "private": true,
  "description": "OpenIDEA QA fixture: Stylelint diagnostics and fixes for CSS, SCSS and Less",
  "type": "module",
  "scripts": {
    "lint": "stylelint \"src/**/*.{css,scss,less}\"",
    "fix": "stylelint \"src/**/*.{css,scss,less}\" --fix"
  },
  "devDependencies": {
    "postcss-less": "6.0.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-config-standard-scss": "18.0.0"
  }
}
