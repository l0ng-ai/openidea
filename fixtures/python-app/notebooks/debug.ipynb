   "source": [
    "def double(x):\n",
    "    y = x * 2\n",
    "    return y"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "loop",
   "metadata": {},
   "outputs": [],
   "source": [
    "total = 0\n",
    "for n in range(3):\n",
    "    total += double(n)\n",
    "print(total)"
   ]
  }
