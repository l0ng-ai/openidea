{
    "name": "openidea/php-app",
    "description": "OpenIDEA QA fixture: shipping quotes and customs charges for forwarded parcels.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "quote": "php bin/quote.php",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
