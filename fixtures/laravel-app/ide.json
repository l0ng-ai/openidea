{
  "$schema": "https://laravel-ide.com/schema/laravel-ide-v2.json",
  "completions": [
    {
      "complete": "routeName",
      "condition": [{ "functionNames": ["nav_link"], "parameters": [2] }]
    },
    {
      "complete": "configKey",
      "condition": [{ "functionNames": ["blog_setting"] }],
      "options": { "prefix": "blog." }
    },
    {
      "complete": "staticStrings",
      "condition": [
        { "functionNames": ["feed_theme"] },
        { "place": "arrayValueWithKey", "keys": ["theme"], "functionNames": ["feed_options"] }
      ],
      "options": { "strings": ["light", "dark", "contrast"] }
    },
    {
      "complete": "directoryFiles",
      "condition": [{ "functionNames": ["stylesheet"] }],
      "options": { "directory": "resources/css", "recursive": true, "suffixToClear": ".css" }
    },
    {
      "complete": "viewName",
      "condition": [
        { "place": "returnString", "methodNames": ["template"], "classParentFqn": ["\\Illuminate\\View\\Component"] }
      ]
    },
    {
      "complete": "inertiaPage",
      "condition": [{ "functionNames": ["page_link"] }]
    }
  ],
  "blade": {
    "directives": [{ "name": "price", "prefix": "<?php echo number_format(", "suffix": ", 2); ?>" }],
    "ifDirectives": [{ "name": "feature", "prefix": "<?php if (feature(", "suffix": ")): ?>" }]
  },
  "codeGenerations": [
    {
      "id": "acme.dto",
      "name": "Data Transfer Object",
      "classSuffix": "Data",
      "parameters": [
        { "id": "readonly", "name": "Read-only", "type": "checkbox", "variable": "READONLY", "defaultValue": "true" },
        {
          "id": "source",
          "name": "Source",
          "type": "select",
          "variable": "SOURCE",
          "options": { "request": "Request", "model": "Model" },
          "defaultValue": "request"
        },
        { "id": "summary", "name": "Summary", "type": "string", "variable": "SUMMARY", "optional": true }
      ],
      "files": [
        {
          "appNamespace": "Data",
          "baseClass": "\\Spatie\\LaravelData\\Data",
          "fallbackBaseClass": "\\App\\Data\\BaseData",
          "template": {
            "type": "stub",
            "path": "stubs/dto.stub",
            "parameters": { "namespace": "${NAMESPACE}", "DummyClass": "${INPUT_CLASS}" }
          }
        },
        {
          "directory": "docs/data",
          "name": "${INPUT_CLASS|snakeCase}.md",
          "template": { "type": "stub", "path": "stubs/missing.stub", "fallbackPath": "stubs/dto.md.stub" }
        }
      ]
    }
  ],
  "packages": { "disabledPackages": ["livewire/livewire"] },
  "helperCode": {}
}
